# ═══════════════════════════════════════════════════════════
# Pixx Bicycle Owner's Declaration System — Environment Config
# PixxTechnologiees — UK Bicycle Business
# ═══════════════════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:      mongodb://localhost:27017/pixx-bicycle
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/pixx-bicycle
MONGODB_URI=mongodb://localhost:27017/pixx-bicycle

# JWT — use a long, random secret (minimum 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — Allowed client origins
# Separate mobile does not need an origin entry (no browser origin header)
CLIENT_URL=http://localhost:8081
ADMIN_WEB_URL=https://bicycle-uuue.vercel.app

# Cloud Storage (Phase 4 — Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_SIZE_MB=10
